{
  "name": "@zktable/core",
  "version": "0.1.1",
  "description": "zkTable SDK: declarative game model (defineGame), deterministic engine, ZK component markers",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/freedanjeremiah/zktable.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/freedanjeremiah/zktable#readme",
  "bugs": {
    "url": "https://github.com/freedanjeremiah/zktable/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  }
}
