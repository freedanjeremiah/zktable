{
  "name": "@zktable/agents",
  "version": "0.1.1",
  "description": "zkTable AI agent harness: game-agnostic Agent interface, HeuristicAgent/RandomAgent baselines, and ClaudeAgent. Agents see only a PlayerView (public state + their own secret) and move through the same proof path as humans.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/freedanjeremiah/zktable.git",
    "directory": "packages/agents"
  },
  "homepage": "https://github.com/freedanjeremiah/zktable#readme",
  "bugs": {
    "url": "https://github.com/freedanjeremiah/zktable/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.110.0",
    "@zktable/core": "workspace:*"
  },
  "engines": {
    "node": ">=20"
  }
}
