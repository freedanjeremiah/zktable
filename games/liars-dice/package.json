{
  "name": "@zktable/liars-dice",
  "version": "0.1.1",
  "description": "Liar's Dice: hidden ZK-proven-fair rolls + escalating bluff bids, the zkTable `dice` + `sealed` showcase (defineGame + real ZK-verified dice)",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/freedanjeremiah/zktable.git",
    "directory": "games/liars-dice"
  },
  "homepage": "https://github.com/freedanjeremiah/zktable#readme",
  "bugs": {
    "url": "https://github.com/freedanjeremiah/zktable/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "play": "tsx src/play.ts"
  },
  "dependencies": {
    "@zktable/core": "workspace:*"
  },
  "devDependencies": {
    "tsx": "^4.19.2"
  },
  "engines": {
    "node": ">=20"
  }
}
